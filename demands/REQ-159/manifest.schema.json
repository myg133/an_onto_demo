{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontok.dev/schemas/bundle-manifest-1.0.json",
  "title": "ontok 构建包清单（bundle manifest）v1.0",
  "description": "构建端产出、服务端校验。任何字段缺失或类型不符 => 服务端整包拒绝，不做默认值猜测。",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "project", "ontology_seq", "built_at", "builder", "components", "files"],
  "properties": {
    "bundle_version": {
      "const": "1.0",
      "description": "包格式版本。服务端只认它认识的版本；不认识的拒绝（不尝试兼容）。"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "必须与接收项目的名字逐字相同（防串包）。"
    },
    "ontology_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "构建端这份本体的序号（仅作展示与追溯；服务端入库时重新分配版本号）。"
    },
    "built_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC 时间，带 Z 或偏移。"
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "examples": ["ontok-builder"] },
        "version": { "type": "string", "examples": ["0.2.9"] },
        "host": { "type": "string" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology"],
      "properties": {
        "ontology": { "$ref": "#/$defs/component" },
        "am": { "$ref": "#/$defs/component" },
        "db": { "$ref": "#/$defs/dbComponent" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "必须覆盖包内每一个文件（含 manifest 自身以外的全部）。服务端逐个核 sha256，任一不符 => 整包拒。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "description": "相对路径，正斜杠分隔。禁止 .. / 绝对路径 / 符号链接。",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "dbComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "requires_dsn"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requires_dsn": {
          "type": "boolean",
          "description": "true => 服务端必须先拿到可用 DSN 才允许 import。false => 有 schema 描述但不连库（例如本体模式）。"
        },
        "dialect": {
          "type": "string",
          "enum": ["postgresql", "mysql", "sqlserver", "oracle"],
          "description": "requires_dsn=true 时必填。"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "requires_dsn": { "const": true } }, "required": ["requires_dsn"] },
          "then": { "required": ["dialect"] }
        }
      ]
    }
  }
}
