# ── 必填 ────────────────────────────────────────────────
# 元数据库（本体/提案/快照）—— 由 compose 里的 db 服务提供
PG_USER=postgres
PG_PASSWORD=change-me
PG_DB=ontok
PG_PORT=55432

# 源库（业务库，只读）—— 外部，不在本 compose 里
ONTOK_SOURCE_DATABASE_URL=postgresql://readonly:change-me@10.0.0.10:5432/business

# 本体项目与版本（先用 CLI 建好并冻结）
ONTOK_PROJECT=anspire_prod
ONTOK_VERSION=3

# ── 可选 ────────────────────────────────────────────────
ONTOK_IMAGE=ontok:dev
TZ=Asia/Shanghai
QUERY_PORT=8800
CONSOLE_PORT=8899
