{
  "class": "alarm_policy",
  "filter": {},
  "pushdown": ["module", "policy_name"],
  "ref": "access#AlarmPolicy@v1",
  "source": {"base_url": "https://monitor.tencentcloudapi.com", "auth_mode": "tc3-hmac-sha256"},
  "operation": {
    "action": "DescribeAlarmPolicies", "content_type": "application/json",
    "headers": {"Content-Type": "application/json; charset=utf-8", "X-TC-Action": "{action}",
                "X-TC-Timestamp": "{timestamp}", "X-TC-Version": "{version}"},
    "method": "POST", "path": "/",
    "vars": {"action": "DescribeAlarmPolicies", "version": "2018-07-24"}, "version": "2018-07-24"
  },
  "request": {
    "bindings": {"module": {"source": "default"}, "policy_name": {"source": "filter"}},
    "defaults": {"Region": "ap-guangzhou", "module": "monitor"},
    "paging": {"limit": "PageSize", "max_limit": 100, "offset_base": 1, "page": "PageNumber"},
    "required": ["module"], "template": {"Module": "{module}", "PolicyName": "{policy_name}"}
  },
  "iterator": "$.Response.Policies[*]",
  "fields": {"policy_name": "PolicyName", "monitor_type": "MonitorType", "enable": "Enable",
             "namespace": "Namespace", "condition": "Condition", "remark": "Remark"},
  "auth": {"credential_env": ["TENCENT_SECRET_ID", "TENCENT_SECRET_KEY"],
           "signed_headers": ["content-type", "host", "x-tc-action"],
           "timestamp": {"header": "X-TC-Timestamp", "format": "unix-seconds"},
           "scope": ["date", "service", "tc3_request"]}
}
