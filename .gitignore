/target
.env

# REQ-003 抽取产物（可重跑生成，不入库）
out/

# Dev 临时工作区（REQ-121 · H-2）
# 该目录沉淀真名 TTL / proposal（model-v3.ttl / r2rml-proposal.json 等，>900KB），
# 与 REQ-084 N1 同类：一句 `git add -A` 就会把客户表名带进库。
/.scratch/

# QA 产物工作区（REQ-084 QA 发现 N1·高危）
# 该目录会沉淀 classify/rows/inventory/备份等中间件，
# 其中含**全部 91 个真实客户表名**。develop 分支的 .gitignore
# 原本不覆盖它，一句 `git add -A` 就会让整轮脱敏归零。
/.review-workspace/

# REQ-162 · 本机评审台在工作目录里留下的状态（裁决 / 定版 / 构建包）。
# 它是**每个工作目录各自的**运行态，不是源码：一句 git add -A 不该把它带进仓。
# （草稿本身仍在 out/proposal.json，那是 agent 的产物，照旧由各仓自己决定要不要跟踪。）
/.ontok/

# npm 打包产物（由 node npm/prepare.mjs 生成，不入库）
/npm/out/
