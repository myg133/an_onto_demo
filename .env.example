# ontok 环境变量样例（⛔ 真实口令不入库）
#
# 元数据库（服务用）
ONTOK_DATABASE_URL=postgresql://<user>:<pass>@<host>:<port>/<db>
# query serve 的写面密钥（64 hex）
ONTOK_SECRET_KEY=<openssl rand -hex 32 的结果>

# ⚠️ 测试库**必须是专用库**：库名要含 test / scratch / tmp / ci / dev。
#    指向业务库会被 `config::test_database_url()` 的防污染闸**直接拒绝**（不是警告）。
#    事故背景：2026-10-27/28 两次把 14 个 `t_req…` 项目写进了 UAT 元数据库，
#     Studio 里全是打不开的项目。
ONTOK_TEST_DATABASE_URL=postgresql://postgres:postgres123@172.16.120.20:30432/ontok_test_scratch

# 逃生阀（⛔ 正常别开）：确实只有共享库、且接受污染时才设 1
# ONTOK_TEST_DB_ALLOW_SHARED=1
